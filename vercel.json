{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/dashboard", "destination": "/sign-in.html" },
    { "source": "/dashboard/", "destination": "/sign-in.html" },
    { "source": "/sign-in", "destination": "/sign-in.html" },
    { "source": "/signin", "destination": "/sign-in.html" },
    { "source": "/login", "destination": "/sign-in.html" },
    { "source": "/create-password", "destination": "/create-password.html" },
    { "source": "/dashboard/:slug", "destination": "/dashboard-app.html" },
    { "source": "/dashboard/:slug/", "destination": "/dashboard-app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/admin-tasks?task=send-report&frequency=weekly", "schedule": "0 9 * * 1" },
    { "path": "/api/admin-tasks?task=send-report&frequency=monthly", "schedule": "0 9 1 * *" }
  ]
}
